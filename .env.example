# Server
NODE_ENV=development
PORT=3000

# Database
MONGO_URI=mongodb://localhost:27017/bikershub

# JWT
JWT_SECRET=your-jwt-secret-min-32-characters-here
JWT_REFRESH_SECRET=your-refresh-secret-min-32-characters-here
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Cloudinary
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Redis
REDIS_URL=redis://localhost:6379

# Logging
LOG_LEVEL=info

# CORS (comma-separated list of allowed origins)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Geocoder
GEOCODER_USER_AGENT=BikersHub/1.0 (server geocoder)

# Weather API (optional — required only if weather features are enabled)
WEATHER_API_KEY=your-weather-api-key
